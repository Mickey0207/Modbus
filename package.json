{
  "name": "modbus-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "React + Vite + Electron scaffold",
  "main": "dist-electron/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "package": "npm run build && npx electron-builder --dir",
    "package:win": "npm run build && npx electron-builder --win",
    "package:nsis": "npm run build && npx electron-builder --win nsis"
  },
  "dependencies": {
    "antd": "^5.27.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0"
  },
  "build": {
    "appId": "com.example.modbus",
    "productName": "ModbusApp",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
