{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "noEmit": true,
    "composite": false,
    "paths": {
      "@/components": ["src/components/index.ts"],
      "@/components/*": ["src/components/*"],
      "@/modules/*": ["src/modules/*"],
      "@/layout/*": ["src/layout/*"],
      "@/styles/*": ["src/styles/*"],
      "@/pages/*": ["src/pages/*"],
      "@/contexts/*": ["src/contexts/*"],
  "@/api": ["src/api/index.ts"],
      "@/api/*": ["src/api/*"],
      "@/hooks/*": ["src/hooks/*"]
    }
  },
  "include": ["src"]
}
